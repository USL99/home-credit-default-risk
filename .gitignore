# Виртуальное окружение Python
.venv/

# Настройки PyCharm
.idea/

# Служебные файлы Python
__pycache__/
*.py[cod]

# Временные файлы Jupyter
.ipynb_checkpoints/

# Исходные данные Kaggle
data/raw/*
!data/raw/.gitkeep

# Обработанные данные
data/processed/*
!data/processed/.gitkeep

# Файлы для отправки на Kaggle
submissions/*
!submissions/.gitkeep

# Сохранённые графики
reports/figures/*
!reports/figures/.gitkeep

# Секретные файлы
.env
kaggle.json

# Системные файлы
.DS_Store
Thumbs.db